rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsTicket() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if ownsUser(userId)
        && request.resource.data.telegramId is string
        && request.resource.data.ticketsCount == 0
        && request.resource.data.favoritesCount == 0;
      allow read, update, delete: if ownsUser(userId);
    }

    match /tickets/{ticketId} {
      allow create: if ownsTicket()
        && request.resource.data.title is string
        && request.resource.data.jsonData is map
        && request.resource.data.favorite is bool;
      allow read, update, delete: if signedIn()
        && resource.data.ownerId == request.auth.uid;
    }

    match /links/{linkId} {
      allow create: if signedIn();
      allow read: if true;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
